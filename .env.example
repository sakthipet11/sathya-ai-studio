# AI provider keys — set only on the server. Never expose to the browser.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: default model per provider
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-70b-versatile

# Optional: contact form delivery endpoint (mail service or serverless function)
CONTACT_FORM_ENDPOINT=
